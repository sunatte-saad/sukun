    <string name="welcome_to_sukun_settings">Welcome to the settings!
        \n\nRemember, if you have any questions, our About page has the answer.</string>
    <string name="rate_us_message">Hi, you won\'t see this message again.
        \n\nIf you\'re finding Sukun useful, could you please leave a 5-star review? It\'ll mean the world to us. Thank you!</string>
    <string name="share_message">We need your help! We believe everyone should know about Sukun and its benefits, but we can\'t do it alone.
        \n\nCould you please share Sukun with your friends, family, and followers? Thank you for your support! ❤</string>
    <!--    <string name="share_message">Your monthly reminder - you should use your phone, not the other way round. Stay strong. You\'re doing great!-->
    <!--         \n\nIf you have a moment to spare, could you please share Sukun with others? Sukun needs people. More importantly, people need Sukun.</string>-->
    <string name="keyboard_message">Hi, keyboard is the fastest way to find and launch apps in Sukun. Can we request you to keep this On for a few more days and then decide?
        \n\nThe choice is always yours.</string>
    <string name="digital_wellbeing_message">If you want to set time limits for certain apps, Digital Wellbeing feature of Android can help you do it.           Please search for Digital Wellbeing in your phone settings and enable it.</string>
    <string name="app_usage_message">To show/hide your screen time on the home screen, please allow or disallow the app usage permission.
        \n\nNote: No app usage data is collected. Everything is processed on your device.</string>
    <string name="pro_message"></string>
    <string name="wallpaper_message">Sukun offers beautiful new wallpapers daily. Give your homescreen a fresh new look every day, for free!
        \n\nWant to try it?</string>
    <string name="accessibility_service_description">The accessibility permission is required to enable double tap to lock and home button to show recent apps. Any data acquired by Sukun via this service will not leave your device.</string>
    <string name="support_sukun_for_free">Support Sukun for free by using our Amazon affiliate link.</string>
    <string name="support_sukun_message">Every time you buy something using our link, we get a small commission. Please save the link and use it whenever you shop online.\nThank you!</string>
