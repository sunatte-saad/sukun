<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_rectangle_dark"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/focusModeCustomTitle"
            style="@style/TextLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/focus_mode_custom_prompt"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/focusModeCustomSubtitle"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/focus_mode_custom_prompt_subtitle"
            android:textColor="?attr/primaryColorTrans80" />

        <EditText
            android:id="@+id/focusCustomMinutesInput"
            style="@style/TextMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/focus_mode_dialog_button"
            android:gravity="center_vertical"
            android:hint="@string/minutes"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLines="1"
            android:paddingHorizontal="18dp"
            android:paddingVertical="16dp"
            android:textColor="?attr/primaryColor"
            android:textColorHint="?attr/primaryColorTrans50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/focusCustomCancel"
                style="@style/TextSmallBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="14dp"
                android:text="@string/cancel"
                android:textColor="?attr/primaryColorTrans80" />

            <TextView
                android:id="@+id/focusCustomStart"
                style="@style/TextSmallBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/focus_mode_dialog_button"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="14dp"
                android:text="@string/start_focus_mode"
                android:textColor="?attr/primaryColor" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
