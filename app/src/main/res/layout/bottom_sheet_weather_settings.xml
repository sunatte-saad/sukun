<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_weather_sheet"
    android:clipToPadding="false"
    android:fillViewport="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="32dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            style="@style/TextSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingVertical="4dp"
            android:text="@string/weather_options"
            android:textColor="?attr/primaryColorTrans80" />

        <FrameLayout
            android:id="@+id/weatherSourceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:animateLayoutChanges="true">

            <TextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingVertical="8dp"
                android:text="@string/weather_source"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/weatherSourceValue"
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:padding="8dp"
                tools:text="@string/device_location" />

            <HorizontalScrollView
                android:id="@+id/weatherSourceChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:background="@drawable/rounded_primary_gradient"
                android:elevation="8dp"
                android:fadingEdgeLength="8dp"
                android:outlineAmbientShadowColor="@color/colorPrimaryDark"
                android:outlineSpotShadowColor="@color/colorPrimaryDark"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none"
                android:visibility="gone"
                tools:ignore="UnusedAttribute">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipWeatherDevice"
                        style="@style/TextSmallBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="@string/device_location" />

                    <TextView
                        android:id="@+id/chipWeatherManual"
                        style="@style/TextSmallBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="@string/manual_location" />

                    <TextView
                        android:id="@+id/chipWeatherGoogle"
                        style="@style/TextSmallBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:text="@string/google_weather_short" />
                </LinearLayout>
            </HorizontalScrollView>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/weatherLocationRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingVertical="8dp"
                android:text="@string/location"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/weatherLocationValue"
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:padding="8dp"
                tools:text="Lahore" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/weatherUnitsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:animateLayoutChanges="true">

            <TextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingVertical="8dp"
                android:text="@string/weather_units"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/weatherUnitsValue"
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:padding="8dp"
                tools:text="°C" />

            <LinearLayout
                android:id="@+id/weatherUnitsSelectLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:background="@drawable/rounded_primary_gradient"
                android:elevation="8dp"
                android:orientation="horizontal"
                android:outlineAmbientShadowColor="@color/colorPrimaryDark"
                android:outlineSpotShadowColor="@color/colorPrimaryDark"
                android:paddingHorizontal="12dp"
                android:paddingVertical="2dp"
                android:visibility="gone"
                tools:ignore="UnusedAttribute">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/chipWeatherCelsius"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="@string/celsius_short" />

                <TextView
                    android:id="@+id/chipWeatherFahrenheit"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="@string/fahrenheit_short" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
