<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_weather_sheet"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_chip_unselected" />

        <FrameLayout
            android:id="@+id/weatherToggleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingVertical="8dp"
                android:text="@string/weather"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/weatherToggle"
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:padding="8dp"
                android:text="@string/off" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/weatherSubSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/weather_source"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/weatherSourceSummary"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:padding="8dp"
                    tools:text="Device" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/rounded_primary_gradient"
                android:elevation="4dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/chipManual"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:gravity="center"
                    android:minHeight="36dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:text="@string/manual_location" />

                <TextView
                    android:id="@+id/chipDevice"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:gravity="center"
                    android:minHeight="36dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:text="@string/device_location" />

                <TextView
                    android:id="@+id/chipGoogle"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="36dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:text="@string/google_weather_short" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/locationSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:id="@+id/locationRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingVertical="8dp"
                        android:text="@string/weather_location"
                        android:textColor="?attr/primaryColor" />

                    <TextView
                        android:id="@+id/locationValueLabel"
                        style="@style/TextSmallBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginStart="72dp"
                        android:layout_marginEnd="4dp"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:padding="8dp"
                        tools:text="Lahore, Pakistan" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/locationEditLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/rounded_primary_gradient"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="2dp"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etLocation"
                        style="@style/TextSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/type_city_name"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingVertical="8dp"
                        android:textColorHint="?attr/primaryColorTrans50" />

                    <TextView
                        android:id="@+id/btnSaveLocation"
                        style="@style/TextSmallBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:paddingVertical="8dp"
                        android:text="@string/save" />

                    <TextView
                        android:id="@+id/btnCloseLocation"
                        style="@style/TextSmallBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:paddingVertical="8dp"
                        android:text="@string/close" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/weatherUnitsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/TextSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingVertical="8dp"
                    android:text="@string/weather_units"
                    android:textColor="?attr/primaryColor" />

                <TextView
                    android:id="@+id/weatherUnitsValue"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:padding="8dp"
                    tools:text="°C" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
