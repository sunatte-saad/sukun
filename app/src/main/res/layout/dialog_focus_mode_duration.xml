<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_rectangle_dark"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/focusModeDialogTitle"
            style="@style/TextLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/focus_mode_duration_prompt"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/focusModeDialogSubtitle"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/focus_mode_duration_prompt_subtitle"
            android:textColor="?attr/primaryColorTrans80" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/focusDuration15m"
                style="@style/TextMedium"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/focus_mode_dialog_button"
                android:gravity="center"
                android:text="@string/focus_15m"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/focusDuration30m"
                style="@style/TextMedium"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/focus_mode_dialog_button"
                android:gravity="center"
                android:text="@string/focus_30m"
                android:textColor="?attr/primaryColor" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/focusDuration1h"
                style="@style/TextMedium"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/focus_mode_dialog_button"
                android:gravity="center"
                android:text="@string/focus_1h"
                android:textColor="?attr/primaryColor" />

            <TextView
                android:id="@+id/focusDuration2h"
                style="@style/TextMedium"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/focus_mode_dialog_button"
                android:gravity="center"
                android:text="@string/focus_2h"
                android:textColor="?attr/primaryColor" />
        </LinearLayout>

        <TextView
            android:id="@+id/focusDurationCustom"
            style="@style/TextSmallBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/focus_mode_dialog_button"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp"
            android:text="@string/custom"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/focusDurationCancel"
            style="@style/TextSmallBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="@string/cancel"
            android:textColor="?attr/primaryColorTrans80" />

    </LinearLayout>

</FrameLayout>
