<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_rect_dialog"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/setupHomeAppsTitle"
            style="@style/TextSmallBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/primaryColor" />

        <TextView
            android:id="@+id/setupHomeAppsMessage"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="8dp"
            android:textColor="?attr/primaryColorTrans80" />

        <TextView
            android:id="@+id/setupHomeAppsFallback"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="8dp"
            android:text="@string/setup_home_apps_fallback"
            android:textColor="?attr/primaryColorTrans80"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/setupHomeAppsList"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/setupHomeAppsSkip"
            style="@style/TextSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:text="@string/skip"
            android:textColor="?attr/primaryColorTrans80"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
