<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainActivityLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">

    <fragment
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        tools:ignore="FragmentTagUsage" />

    <FrameLayout
        android:id="@+id/messageLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/dialogShadeColor"
        android:clickable="true"
        android:clipToPadding="false"
        android:focusable="true"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/rounded_rectangle_dark"
            android:elevation="8dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/colorPrimaryDark"
            android:outlineSpotShadowColor="@color/colorPrimaryDark"
            android:paddingVertical="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            tools:targetApi="p">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:alpha="0.5"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    android:padding="6dp"
                    android:src="@drawable/ic_close" />

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/TextLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="48dp"
                    android:clickable="false"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textColor="?attr/primaryColor" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvMessage"
                style="@style/TextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/primaryColor"
                tools:text="@string/rate_us_message" />

            <TextView
                android:id="@+id/tvAction"
                style="@style/TextSmallBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="@string/okay"
                android:textAllCaps="false"
                android:textSize="18sp" />

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
        android:id="@+id/onboardingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_onboarding_card"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="26dp"
        android:paddingTop="22dp"
        android:paddingBottom="26dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Calm, minimalist progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/onboardingProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/bg_onboarding_progress" />

            <TextView
                android:id="@+id/onboardingStepCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="?attr/primaryColorTrans50"
                style="@style/TextSmall"
                tools:text="3 / 12" />
        </LinearLayout>


        <!-- Clear, purpose-first title -->
        <TextView
            android:id="@+id/onboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:textColor="?attr/primaryColor"
            style="@style/TextLarge"
            tools:text="Your calmer home" />

        <!-- Short explanation of the whole purpose -->
        <TextView
            android:id="@+id/onboardingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="?attr/primaryColor"
            style="@style/TextMedium"
            tools:text="Sukun is a simple, calm home screen that helps you focus and use your phone with intention." />

        <!-- Gentle guidance -->
        <TextView
            android:id="@+id/onboardingActionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="?attr/primaryColorTrans80"
            style="@style/TextSmall"
            tools:text="Tap any empty spot to place an app you love." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnOnboardingBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="@string/onboarding_back"
                android:textColor="?attr/primaryColorTrans80"
                style="@style/TextSmall" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnOnboardingSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:text="@string/onboarding_skip_tour"
                android:textColor="?attr/primaryColorTrans50"
                style="@style/TextSmall" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnOnboardingPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_primary_gradient"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:text="@string/onboarding_start_tour"
            android:visibility="gone"
            style="@style/TextMedium"
            tools:ignore="TextContrastCheck"
            tools:visibility="visible" />

    </LinearLayout>
</FrameLayout>