    <string name="welcome_to_sukun_settings">¡Bienvenido a los ajustes!
        \n\nRecuerda, si tienes alguna pregunta, nuestra página de Acerca de tiene la respuesta.</string>
    <string name="rate_us_message">Hola, no volverás a ver este mensaje.
        \n\nSi te resulta útil Sukun, ¿podrías dejarnos una reseña de 5 estrellas? Significaría mucho para nosotros. ¡Gracias!</string>
    <string name="share_message">¡Necesitamos tu ayuda! Creemos que todos deberían conocer Sukun y sus beneficios, pero no podemos hacerlo solos.
        \n\n¿Podrías compartir Sukun con tus amigos, familia y seguidores? ¡Gracias por tu apoyo! ❤</string>
    <string name="keyboard_message">Hola, el teclado es la forma más rápida de encontrar y abrir apps en Sukun. ¿Podrías dejarlo activado unos días más y luego decidir?
        \n\nLa decisión siempre es tuya.</string>
    <string name="digital_wellbeing_message">Si quieres establecer límites de tiempo para ciertas apps, la función de Bienestar Digital de Android puede ayudarte. Por favor busca Bienestar Digital en los ajustes de tu teléfono y actívalo.</string>
    <string name="app_usage_message">Para mostrar u ocultar tu tiempo de pantalla en la pantalla de inicio, permite o deniega el permiso de uso de apps.
        \n\nNota: No se recopilan datos de uso de apps. Todo se procesa en tu dispositivo.</string>
    <string name="pro_message" />
    <string name="wallpaper_message">Sukun ofrece hermosos fondos de pantalla nuevos cada día. ¡Dale a tu pantalla de inicio un aspecto fresco todos los días, gratis!
        \n\n¿Quieres probarlo?</string>
    <string name="accessibility_service_description">El permiso de accesibilidad es necesario para activar el doble toque para bloquear y el botón de inicio para mostrar apps recientes. Ningún dato adquirido por Sukun a través de este servicio saldrá de tu dispositivo.</string>
    <string name="support_sukun_for_free">Apoya a Sukun gratis usando nuestro enlace de afiliado de Amazon.</string>
    <string name="support_sukun_message">Cada vez que compras algo usando nuestro enlace, recibimos una pequeña comisión. Por favor guarda el enlace y úsalo cuando compres en línea.\n¡Gracias!</string>
