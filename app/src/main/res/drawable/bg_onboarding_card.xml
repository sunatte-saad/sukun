<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Use existing dialogShadeColor for a subtle floating surface over wallpaper -->
    <solid android:color="?attr/dialogShadeColor" />
    <corners android:radius="20dp" />
    <!-- Subtle border using the lightest available primary trans -->
    <stroke
        android:width="1dp"
        android:color="?attr/primaryColorTrans50" />
</shape>